menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = app
source "subsys/logging/Kconfig.template.log_config"

menu "Logging"

config APP_LOGGING_MINIMAL
    bool "Suppress all APP debug log messages"
    default false

if !APP_LOGGING_MINIMAL

config APP_LOG_LEVEL
    default 4

endif

config APP_USB_LOGGING
    bool "Enable USB CDC ACM logging to help debug"
    select LOG
    select USB_DEVICE_STACK
    select USB_CDC_ACM
    select SERIAL
    select CONSOLE
    select UART_INTERRUPT_DRIVEN
    select UART_LINE_CTRL
    select UART_CONSOLE

if APP_USB_LOGGING

choice USB_CDC_ACM_LOG_LEVEL_CHOICE
    default USB_CDC_ACM_LOG_LEVEL_OFF
endchoice

choice USB_DRIVER_LOG_LEVEL_CHOICE
    default USB_DRIVER_LOG_LEVEL_OFF
endchoice

# We do this to avoid log loop where logging to USB generates more log messages.

config USB_CDC_ACM_RINGBUF_SIZE
    default 1024

config LOG_PROCESS_THREAD_STARTUP_DELAY_MS
    default 1000

#APP_USB_LOGGING
endif

config APP_RTT_LOGGING
    bool "Enable RTT logging to help debug"
    select LOG
    select DEBUG
    select ASSERT
    select USE_SEGGER_RTT
    select CONSOLE
    select RTT_CONSOLE

if APP_RTT_LOGGING

config SEGGER_RTT_BUFFER_SIZE_UP
    default 8192

#APP_RTT_LOGGING
endif

if APP_USB_LOGGING || APP_RTT_LOGGING

config LOG_BUFFER_SIZE
    default 8192

config LOG_PROCESS_THREAD_SLEEP_MS
    default 100

#APP_USB_LOGGING || APP_RTT_LOGGING
endif

#Logging
endmenu

choice APP_DISPLAY_WORK_QUEUE
    prompt "Work queue selection for UI updates"

config APP_DISPLAY_WORK_QUEUE_SYSTEM
    bool "Use default system work queue for UI updates"

config APP_DISPLAY_WORK_QUEUE_DEDICATED
    bool "Use dedicated work queue for UI updates"

endchoice

if APP_DISPLAY_WORK_QUEUE_DEDICATED

config APP_DISPLAY_DEDICATED_THREAD_STACK_SIZE
    int "Stack size for dedicated UI thread/queue"
    default 16384

config APP_DISPLAY_DEDICATED_THREAD_PRIORITY
    int "Thread priority for dedicated UI thread/queue"
    default 5

endif # APP_DISPLAY_WORK_QUEUE_DEDICATED
